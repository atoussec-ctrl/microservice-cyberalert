# ---- Application ----
NODE_ENV=development
PORT=3000

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=threat_intelligence
# In production, manage schema with migrations and set this to false.
DB_SYNCHRONIZE=true
DB_SSL=false

# ---- AWS / LocalStack ----
AWS_REGION=us-east-1
# Point at LocalStack for local dev; leave empty to use real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ---- Messaging ----
# Queue subscribed to the `threat-detected` SNS topic.
THREAT_ANALYSIS_QUEUE_URL=http://localhost:4566/000000000000/threat-analysis-queue
# Topic to publish `block-ip-command` events for critical threats.
BLOCK_IP_COMMAND_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:block-ip-command
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10
SQS_VISIBILITY_TIMEOUT=60
SQS_POLLING_ENABLED=true
